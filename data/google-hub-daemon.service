[Unit]
Description=Google Hub: search, tasks and voice for GNOME
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.maximeallanic.GoogleHub
# @DAEMON_DIR@ is replaced by install.sh with the installed daemon directory ($XDG_DATA_HOME/google-hub/daemon).
Environment="PYTHONPATH=@DAEMON_DIR@"
ExecStart=/usr/bin/python3 -m google_hub
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
