[Desktop Entry]
Type=Application
Name=Gemini (Google Hub)
Comment=Gemini drawer of Google Hub
Comment[fr]=Volet Gemini de Google Hub
# Only the Shell extension starts the drawer (Meta.WaylandClient, panel.js): a copy started elsewhere would take
# the bus name and leave the Shell without its window. Launching this entry (gtk-launch, a click on one of the
# drawer's notifications) therefore asks the extension to toggle the drawer, as Super+G does (control.js).
Exec=/usr/bin/gdbus call --session --dest io.github.maximeallanic.GoogleHubShell --object-path /io/github/maximeallanic/GoogleHubShell --method io.github.maximeallanic.GoogleHubShell.Toggle
Icon=google-hub-gemini-symbolic
NoDisplay=true
