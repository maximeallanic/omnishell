[Unit]
Description=Omnishell: search, tasks and voice for GNOME
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.maximeallanic.Omnishell
# @DAEMON_DIR@ is replaced by install.sh with the installed daemon directory ($XDG_DATA_HOME/omnishell/daemon).
Environment="PYTHONPATH=@DAEMON_DIR@"
ExecStart=/usr/bin/python3 -m omnishell
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
