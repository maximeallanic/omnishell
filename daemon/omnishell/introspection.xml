<node>
  <interface name="io.github.maximeallanic.Omnishell">
    <method name="Search"><arg type="as" name="terms" direction="in"/><arg type="aa{sv}" name="items" direction="out"/></method>
    <method name="Activate"><arg type="s" name="id" direction="in"/><arg type="as" name="terms" direction="in"/></method>
    <method name="ListTasks"><arg type="aa{sv}" name="tasks" direction="out"/></method>
    <method name="CompleteTask"><arg type="s" name="list" direction="in"/><arg type="s" name="id" direction="in"/></method>
    <method name="AddTask"><arg type="s" name="text" direction="in"/><arg type="a{sv}" name="task" direction="out"/></method>
    <method name="Listen"><arg type="s" name="text" direction="out"/></method>
    <method name="StopListen"/>
    <method name="CancelListen"/>
    <signal name="TasksChanged"/>
    <signal name="ListenState"><arg type="s" name="state"/><arg type="d" name="level"/></signal>
    <property name="Status" type="a{sv}" access="read"/>
    <!-- Milliseconds a client must allow Listen: the daemon's worst case for capture + transcription. -->
    <property name="ListenTimeout" type="u" access="read"/>
  </interface>
</node>
